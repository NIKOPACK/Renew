{
  "name": "renew",
  "version": "0.1.0",
  "private": true,
  "description": "温新：像刷帖子一样学习的开源记忆卡片 App（FSRS 间隔复习 + 自带 Key 的 AI）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NIKOPACK/Renew.git"
  },
  "homepage": "https://github.com/NIKOPACK/Renew",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:app": "node scripts/build.mjs app",
    "build:artifact": "node scripts/build.mjs artifact",
    "serve": "python3 -m http.server 8780 -d www",
    "test": "node scripts/build.mjs app && node tests/e2e.mjs",
    "sync": "node scripts/build.mjs app && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@phosphor-icons/core": "^2.1.1",
    "esbuild": "^0.28.2",
    "katex": "^0.16.9",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^3.11.174",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
